ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
POSTGRES_SCHEMA=agent_platform
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# LLM / agent runtime (required for POST /agents/run).
# Never commit real API keys — copy to .env (gitignored).
#
# OpenAI (default):
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=
#
# DeepSeek (OpenAI-compatible; tool calling supported — see https://api-docs.deepseek.com/):
# LLM_PROVIDER=deepseek
# LLM_API_KEY=          # or DEEPSEEK_API_KEY=
# DEEPSEEK_API_KEY=
# LLM_MODEL=deepseek-flash
# LLM_BASE_URL=https://api.deepseek.com
#
# AGENT_RECURSION_LIMIT=10
# AGENT_ID=default
#
# LangSmith tracing (optional). Off unless LANGSMITH_TRACING=true and a key is set.
# Project is always agent-platform-{ENVIRONMENT} (do not set LANGSMITH_PROJECT).
# Prompts and tool inputs are sent to LangSmith only when tracing is on.
# Trace metadata is limited to execution_id, agent_id, and environment.
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=
