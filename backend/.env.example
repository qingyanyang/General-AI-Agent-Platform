ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
POSTGRES_SCHEMA=agent_platform
# LangGraph checkpoint tables (AsyncPostgresSaver.setup); separate from ORM schema.
CHECKPOINTS_SCHEMA=langgraph
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# Auth0 API access tokens (required for protected routes). Domain is a hostname only.
# Enable RBAC + "Add Permissions in the Access Token" on the Auth0 API; assign roles
# (Admin / Agent Developer / Agent User) in the Dashboard. See backend/README.md (#16).
# AUTH0_DOMAIN=dev-pf7wi26tb5bj8qxz.us.auth0.com
# AUTH0_AUDIENCE=https://api.agent-platform
# Require the access token to carry {AUTH0_AUDIENCE}/email_verified=true.
# Leave false until backend/auth0/post-login-verify-email.js is installed.
# AUTH0_REQUIRE_VERIFIED_EMAIL=false
# Machine-to-machine app with read:users, create:users, read:roles, and role membership scopes.
# AUTH0_MGMT_CLIENT_ID=
# AUTH0_MGMT_CLIENT_SECRET=
# AUTH0_DB_CONNECTION=Username-Password-Authentication

# Integration tests only (pytest): dedicated Postgres URL for checkpointer tests.
# Do not reuse the application DATABASE_URL. Leave unset to skip those tests.
# CHECKPOINT_TEST_DATABASE_URL=postgresql+psycopg://...

# LLM / agent runtime (required for agent runs).
# Never commit real API keys — copy to .env (gitignored).
# Per-agent provider/model live in the agents table (#20); these are process defaults + keys.
#
# OpenAI (default):
# LLM_PROVIDER=openai
# LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=
#
# DeepSeek (OpenAI-compatible; tool calling supported — see https://api-docs.deepseek.com/):
# LLM_PROVIDER=deepseek
# LLM_API_KEY=          # or DEEPSEEK_API_KEY=
# DEEPSEEK_API_KEY=
# LLM_MODEL=deepseek-flash
# LLM_BASE_URL=https://api.deepseek.com
#
# Optional override of the approved model catalog (JSON array).
# APPROVED_LLM_MODELS=[{"provider":"openai","model":"gpt-4o-mini","temperature_min":0,"temperature_max":2},{"provider":"deepseek","model":"deepseek-flash","temperature_min":0,"temperature_max":2}]
#
# AGENT_RECURSION_LIMIT=10
# AGENT_ID=default
#
# LangSmith tracing (optional). Off unless LANGSMITH_TRACING=true and a key is set.
# Project is always agent-platform-{ENVIRONMENT} (do not set LANGSMITH_PROJECT).
# Prompts and tool inputs are sent to LangSmith only when tracing is on.
# Trace metadata is limited to execution_id, agent_id, and environment.
# LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_ENDPOINT=
#
# Optional live model-quality evaluation. Unset skips those examples.
# EVAL_LLM=1 requires LLM_API_KEY, or DEEPSEEK_API_KEY when LLM_PROVIDER=deepseek.
# python -m evals --upload records the evaluation-owned dataset
# agent-platform-agent-core and deletes remote examples absent from the JSON.
# EVAL_LLM=1
