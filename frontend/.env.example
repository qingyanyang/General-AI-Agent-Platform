# Public FastAPI origin (no trailing slash). Used at build time by Vite.
# Local example: http://localhost:8000
# Demo example: https://<container-app-fqdn>
VITE_API_BASE_URL=http://localhost:8000

# Auth0 SPA settings for the existing "EAP Web" application.
# Domain is the tenant hostname only, with no https:// and no path.
# Audience is the API identifier. Do not put a client secret here.
VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=https://api.agent-platform

# Optional absolute http:// or https:// URL of the LangSmith project.
# Execution rows show a copyable correlation id. This link opens the project,
# not an individual trace. Any other scheme is ignored.
VITE_LANGSMITH_PROJECT_URL=
